# .env.example — commit this, no real values

# --- Contact & Quote forms (src/app/api/contact, src/app/api/quote) ---
# Get a key at https://resend.com — free tier covers most small business volumes.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (or Resend's onboarding domain for testing).
EMAIL_FROM="SBITS Website <notifications@sbits.ph>"
# Where form submissions get delivered.
EMAIL_TO=hello@sbits.ph

# --- Content (Sanity CMS) — wire up when Services/Case Studies move to the CMS ---
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_WEBHOOK_SECRET=

# --- Spam protection (Cloudflare Turnstile) — optional, layer on top of the built-in honeypot ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Deployment (Azure Static Web Apps) ---
AZURE_SWA_TOKEN=
